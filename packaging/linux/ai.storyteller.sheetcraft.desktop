[Desktop Entry]
Type=Application
Name=SheetCraft
GenericName=Spreadsheet
Comment=Calculate, analyse and chart data in workbooks
Exec=sheetcraft %F
TryExec=sheetcraft
Icon=ai.storyteller.sheetcraft
Terminal=false
StartupNotify=true
StartupWMClass=ai.storyteller.sheetcraft
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel.sheet.macroEnabled.12;text/csv;text/tab-separated-values;
Keywords=spreadsheet;workbook;sheet;table;formula;chart;pivot;xlsx;csv;tsv;excel;
