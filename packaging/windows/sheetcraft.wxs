<?xml version="1.0" encoding="utf-8"?>
<!--
  SheetCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build sheetcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, App Paths (Win+R `sheetcraft`),
  and SheetCraft offered under "Open with" (and in Settings > Default apps) for .xlsx, .xlsm,
  .csv and .tsv, without taking over the user's default app for them.

  UpgradeCode is fixed for SheetCraft (generated 2026-10-07): never change it, or upgrades
  install side by side instead of replacing the old version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="SheetCraft"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="5511327B-F305-41BE-92D0-EB84944E7C4D"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="SheetCraft spreadsheet" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of SheetCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SheetcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SheetcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/sheetcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/sheetcraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SheetCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="SheetCraft" Level="1">
      <ComponentGroupRef Id="SheetcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="SheetcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="SheetcraftApp" Guid="0507D4B6-12FF-4882-84E1-59083E74A4EB">
        <File Id="SheetcraftExe" Source="$(var.BinDir)\sheetcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="SheetCraft"
              Description="SheetCraft spreadsheet" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SheetcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\sheetcraft.exe" Value="[#SheetcraftExe]" Type="string" />

        <!-- ProgIds: how Explorer opens a file with SheetCraft. Nothing here sets HKCR\.<ext>'s
             default value, so the user's current default app is left alone. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SheetCraft.Workbook" Value="SheetCraft Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SheetCraft.Workbook\DefaultIcon" Value="&quot;[#SheetcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SheetCraft.Workbook\shell\open\command" Value="&quot;[#SheetcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SheetCraft.TextData" Value="SheetCraft Text Data" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SheetCraft.TextData\DefaultIcon" Value="&quot;[#SheetcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SheetCraft.TextData\shell\open\command" Value="&quot;[#SheetcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with": Windows reads only the value names under OpenWithProgids; the data is
             ignored (WiX rejects an empty Value, so it repeats the ProgId). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsx\OpenWithProgids" Name="SheetCraft.Workbook" Value="SheetCraft.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsm\OpenWithProgids" Name="SheetCraft.Workbook" Value="SheetCraft.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.csv\OpenWithProgids" Name="SheetCraft.TextData" Value="SheetCraft.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tsv\OpenWithProgids" Name="SheetCraft.TextData" Value="SheetCraft.TextData" Type="string" />

        <!-- Settings > Default apps: lets the user pick SheetCraft for these types. -->
        <RegistryValue Root="HKLM" Key="Software\SheetCraft\Capabilities" Name="ApplicationName" Value="SheetCraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SheetCraft\Capabilities" Name="ApplicationDescription" Value="Open-source spreadsheet for .xlsx, CSV and TSV files" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SheetCraft\Capabilities\FileAssociations" Name=".xlsx" Value="SheetCraft.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SheetCraft\Capabilities\FileAssociations" Name=".xlsm" Value="SheetCraft.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SheetCraft\Capabilities\FileAssociations" Name=".csv" Value="SheetCraft.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SheetCraft\Capabilities\FileAssociations" Name=".tsv" Value="SheetCraft.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="SheetCraft" Value="Software\SheetCraft\Capabilities" Type="string" />
      </Component>

      <Component Id="SheetcraftCli">
        <File Id="SheetcraftCliExe" Source="$(var.BinDir)\sheetcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
